# Origen de la API de NestJS. next.config.ts la reexpone bajo /api del mismo
# origen para evitar el preflight CORS en cada peticion.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Estilo de mapa. OpenFreeMap sirve teselas vectoriales de OpenStreetMap sin
# clave de API ni costo de licencia. Para uso en produccion con volumen alto,
# lo responsable es autoalojar las teselas de la region afectada.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
